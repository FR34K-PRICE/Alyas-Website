# --- Required in production -------------------------------------------------
# Postgres connection string. On Replit: open the Database tool, create a
# PostgreSQL database and copy DATABASE_URL into Secrets (it may be set for you).
DATABASE_URL=

# Long random string (32+ chars). Used to sign inquiry tokens and to pepper the
# session-token hash. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public origin of the site, no trailing slash. Used for canonical URLs, the
# sitemap and CSRF origin checks. Example: https://alyas-travel.com
SITE_URL=

# --- Optional -----------------------------------------------------------------
# Trust X-Forwarded-For for client IPs (rate limits). "true" behind Replit's proxy.
TRUST_PROXY=true

# Cloudflare Turnstile (extra spam protection for the inquiry form). Leave both
# empty to rely on honeypot + timing + rate limits only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Used only by `npm run create-admin` (safer: let the script prompt you instead).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
